<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/headerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="75dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/headerBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:background="@drawable/header"
                    android:paddingTop="51dp"
                    android:paddingBottom="75dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/userAvatar"
                        android:layout_width="51dp"
                        android:layout_height="51dp"
                        android:layout_marginStart="31dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/avatar_placeholder"
                        android:scaleType="fitXY"/>

                    <TextView
                        android:id="@+id/greetingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Halo, User!"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/searchBarContainer"
                    android:layout_width="match_parent"
                    android:layout_height="46dp" android:layout_marginBottom="-23dp" android:layout_marginHorizontal="28dp"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/kotaksearch"
                    android:elevation="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"  android:paddingEnd="5dp"     android:clipChildren="false"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="12dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/searchText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cari..."
                            android:textColor="#A19B9B"
                            android:textSize="14sp"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>


                        <FrameLayout
                            android:id="@+id/searchIconContainer"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_search_accent"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/searchIcon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/search_icon_magnifier_white"
                                android:scaleType="fitCenter"
                                app:tint="#000000" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:layout_marginHorizontal="60dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="15dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/wisataButton"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:gravity="center"
                        android:background="@drawable/kotakbirubutton"
                        android:elevation="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/wisataIcon"
                            android:layout_width="37dp"
                            android:layout_height="37dp"
                            android:src="@drawable/icon_building_white"
                            android:scaleType="fitXY"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/wisataText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Wisata"
                        android:textColor="#0073E2"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="15dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/transportButton"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:gravity="center"
                        android:background="@drawable/kotakbirubutton"
                        android:elevation="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/transportIcon"
                            android:layout_width="37dp"
                            android:layout_height="37dp"
                            android:src="@drawable/icon_trans"
                            android:scaleType="fitXY"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/transportText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Transportasi"
                        android:textColor="#0073E2"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/promoTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="31dp"
                android:layout_marginBottom="15dp"
                android:text="Promo Spesial Untukmu"
                android:textColor="#1E1E1E"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <RelativeLayout
                android:id="@+id/promoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:layout_marginHorizontal="29dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/promoBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/header"
                    android:src="@drawable/promo_wing"
                    android:scaleType="fitXY"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="17dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/discountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="110dp"
                        android:background="@drawable/bgtulisandiskon"
                        android:paddingVertical="5dp"
                        android:paddingHorizontal="16dp"
                        android:elevation="7dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/discountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DISKON 15%"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/promoMessageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="Pergi-Pergi Jadi Hemat!"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </RelativeLayout>

            <TextView
                android:id="@+id/transportTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="31dp"
                android:layout_marginBottom="10dp"
                android:text="Pilih Transportasi di Kotamu"
                android:textColor="#1E1E1E"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/transportFiltersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="27dp"
                android:layout_marginHorizontal="40dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/keretaFilterButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bgtulisantransportasi"
                    android:paddingVertical="13dp"
                    android:elevation="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/keretaText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kereta"
                        android:textColor="#4A4458"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pesawatFilterButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bgtulisantransportasi"
                    android:paddingVertical="13dp"
                    android:elevation="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/pesawatText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pesawat"
                        android:textColor="#4A4458"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/busFilterButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bgtulisantransportasi"
                    android:paddingVertical="13dp"
                    android:elevation="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/busText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bus"
                        android:textColor="#4A4458"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/recommendationsTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="31dp"
                android:layout_marginBottom="17dp"
                android:text="Rekomendasi Wisata Terbaik"
                android:textColor="#1E1E1E"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="29dp"
                android:clipToPadding="false"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:id="@+id/tourListContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/tourCard1"
                            android:layout_width="203dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bgpilihanwisata"
                            android:paddingBottom="17dp"
                            android:elevation="7dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/tourImage1"
                                android:layout_width="match_parent"
                                android:layout_height="127dp"
                                android:layout_marginBottom="22dp"
                                android:src="@drawable/tour_image_pantai"
                                android:scaleType="fitXY"/>

                            <TextView
                                android:id="@+id/tourTitle1Text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="9dp"
                                android:layout_marginStart="18dp"
                                android:layout_marginEnd="18dp"
                                android:lines="2"
                                android:text="Pantai Kuta - Bali"
                                android:textColor="#1E1E1E"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <LinearLayout
                                android:id="@+id/ratingContainer1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:layout_marginStart="17dp"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/ratingStar1"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="4dp"
                                    android:src="@drawable/star_icon_yellow"
                                    android:scaleType="fitXY"/>

                                <TextView
                                    android:id="@+id/rating1Text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="4.8 | Badung"
                                    android:textColor="#FFC107"
                                    android:textSize="10sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/tourCard2"
                            android:layout_width="203dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bgpilihanwisata"
                            android:paddingBottom="17dp"
                            android:elevation="7dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/tourImage2"
                                android:layout_width="match_parent"
                                android:layout_height="127dp"
                                android:layout_marginBottom="22dp"
                                android:src="@drawable/tour_image_borobudur"
                                android:scaleType="fitXY"/>

                            <TextView
                                android:id="@+id/tourTitle2Text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="9dp"
                                android:layout_marginStart="18dp"
                                android:layout_marginEnd="18dp"
                                android:lines="2"
                                android:text="Candi Borobudur - Jawa Tengah"
                                android:textColor="#1E1E1E"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <LinearLayout
                                android:id="@+id/ratingContainer2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:layout_marginStart="17dp"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/ratingStar2"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="4dp"
                                    android:src="@drawable/star_icon_yellow"
                                    android:scaleType="fitXY"/>

                                <TextView
                                    android:id="@+id/rating2Text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="4.8 | Magelang"
                                    android:textColor="#FFC107"
                                    android:textSize="10sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2DA0F5"
        android:paddingBottom="15dp"
        android:paddingHorizontal="25dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/activeIndicatorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="80dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:gravity="center">

                <View
                    android:id="@+id/homeActiveIndicator"
                    android:layout_width="60dp"
                    android:layout_height="4dp"
                    android:background="#FFFFFF"/>
            </LinearLayout>

            <View
                android:layout_width="80dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <View
                android:layout_width="80dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/homeIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/icon_home_white"
                    android:scaleType="fitXY"/>

                <TextView
                    android:id="@+id/homeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/orderIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/icon_order_blue"
                    android:scaleType="fitXY"/>

                <TextView
                    android:id="@+id/orderText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pemesanan"
                    android:textColor="#0A4181"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/profileIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/icon_profile_blue"
                    android:scaleType="fitXY"/>

                <TextView
                    android:id="@+id/profileText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profil"
                    android:textColor="#0A4181"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>