<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="12dp">

        <View
            android:id="@+id/header_view_admin"
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:background="@drawable/bg_gradient"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="-100dp"
            android:layout_marginEnd="-70dp"
            android:background="@drawable/bg_white_circle_alpha"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/adminAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_placeholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent" />

        <LinearLayout
            android:id="@+id/adminGreetingContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/adminAvatar"
            app:layout_constraintEnd_toStartOf="@id/btn_admin_logout"
            app:layout_constraintStart_toEndOf="@id/adminAvatar"
            app:layout_constraintTop_toTopOf="@id/adminAvatar">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="WisataGO Admin"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_admin_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selamat Datang, Admin!"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_admin_logout"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/icon_logout"
            app:layout_constraintBottom_toBottomOf="@id/adminAvatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/adminAvatar"
            app:tint="#FFFFFF"
            tools:ignore="ContentDescription" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewAdmin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/layout_tab_statistik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="115dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="0dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Transaksi" android:textColor="#757575" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvAdminTotalTransaksi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="0" android:textColor="#1E1E1E" android:textSize="22sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="↗ +12% vs Kmrn" android:textColor="#4CAF50" android:textSize="10sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="115dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="0dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pemesanan Baru" android:textColor="#757575" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvAdminPemesananBaru" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="0" android:textColor="#1E1E1E" android:textSize="22sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="#FFF3E0" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="🔔 5 Baru" android:textColor="#E65100" android:textSize="9sp" android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="115dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="0dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pendapatan (Hari)" android:textColor="#757575" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvAdminPendapatanHari" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Rp 0" android:textColor="#2E7D32" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pendapatan (Bulan Ini)" android:textColor="#1E1E1E" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvAdminPendapatanBulan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Rp 0" android:textColor="#2E7D32" android:textSize="18sp" android:textStyle="bold" />
                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/lineChartPendapatan"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status Pemesanan" android:textColor="#1E1E1E" android:textSize="14sp" android:textStyle="bold" />
                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/pieChartStatus"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Produk Terpopuler (Bulan Ini)" android:textColor="#1E1E1E" android:textSize="14sp" android:textStyle="bold" />
                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/barChartProduk"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wisata Terlaris (Bulan Ini)" android:textColor="#1E1E1E" android:textSize="14sp" android:textStyle="bold" />
                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/barChartWisata"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transport Terlaris (Bulan Ini)" android:textColor="#1E1E1E" android:textSize="14sp" android:textStyle="bold" />
                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/barChartTransport"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daerah Paling Dikunjungi" android:textColor="#1E1E1E" android:textSize="14sp" android:textStyle="bold" />
                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/barChartDaerah"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Riwayat Aktivitas Terbaru"
                            android:textColor="#1E1E1E"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAdminLogs"
                            android:layout_width="match_parent"
                            android:layout_height="350dp"
                            android:nestedScrollingEnabled="true"
                            tools:listitem="@layout/item_admin_log" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View android:layout_width="match_parent" android:layout_height="30dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_tab_pesanan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginTop="8dp" android:text="Manajemen Pesanan" android:textColor="#111111" android:textSize="18sp" android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_admin_search"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_margin="8dp"
                    android:background="@android:drawable/editbox_background"
                    android:hint="Cari Kode Booking / User..."
                    android:paddingHorizontal="16dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_filter_bulan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            app:icon="@android:drawable/ic_menu_month"
                            app:iconTint="#333333"
                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="20dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="12dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#DDDDDD" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_filter_semua"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Semua"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            app:backgroundTint="#2DA0F5"
                            app:cornerRadius="20dp"
                            android:minHeight="40dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_filter_wisata"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Wisata"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            app:backgroundTint="#F0F0F0"
                            app:cornerRadius="20dp"
                            android:minHeight="40dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_filter_kereta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Kereta"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            app:backgroundTint="#F0F0F0"
                            app:cornerRadius="20dp"
                            android:minHeight="40dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_filter_pesawat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Pesawat"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            app:backgroundTint="#F0F0F0"
                            app:cornerRadius="20dp"
                            android:minHeight="40dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_filter_bus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Bus"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            app:backgroundTint="#F0F0F0"
                            app:cornerRadius="20dp"
                            android:minHeight="40dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_admin_all_orders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp" />

                <View android:layout_width="match_parent" android:layout_height="80dp" />
            </LinearLayout>

        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layoutNavbarAdmin"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="@drawable/bg_navbar"
        android:paddingBottom="10dp"
        android:orientation="horizontal"
        android:weightSum="2"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <View
                android:id="@+id/indicatorStats"
                android:layout_width="40dp"
                android:layout_height="5dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_navbar2" />
            <ImageView
                android:id="@+id/btnAdminStats"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/icon_home_white" />
            <TextView
                android:id="@+id/tvAdminStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Statistik"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <View
                android:id="@+id/indicatorOrders"
                android:layout_width="40dp"
                android:layout_height="5dp"
                android:layout_marginBottom="6dp"
                android:background="@android:color/transparent" />
            <ImageView
                android:id="@+id/btnAdminOrders"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/icon_order_blue" />
            <TextView
                android:id="@+id/tvAdminOrders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pemesanan"
                android:textColor="#0A4181"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>