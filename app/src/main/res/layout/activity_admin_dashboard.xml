<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <View
            android:id="@+id/header_view_admin"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="@drawable/bg_gradient"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="-110dp"
            android:layout_marginEnd="-80dp"
            android:background="@drawable/bg_white_circle_alpha"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/adminAvatar"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="36dp"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_placeholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent" />

        <LinearLayout
            android:id="@+id/adminGreetingContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/adminAvatar"
            app:layout_constraintEnd_toStartOf="@id/btn_admin_logout"
            app:layout_constraintStart_toEndOf="@id/adminAvatar"
            app:layout_constraintTop_toTopOf="@id/adminAvatar">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.03"
                android:text="WisataGO Admin"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_admin_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selamat Datang, Admin!"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_admin_logout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/icon_logout"
            app:layout_constraintBottom_toBottomOf="@id/adminAvatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/adminAvatar"
            app:tint="#FFFFFF"
            tools:ignore="ContentDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollViewAdmin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/layout_tab_statistik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#35A1F8"
                        app:cardCornerRadius="12dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Transaksi" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvAdminTotalTransaksi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="↗ +12% vs Kemarin" android:textColor="#BBDEFB" android:textSize="10sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#35A1F8"
                        app:cardCornerRadius="12dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pemesanan Baru" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvAdminPemesananBaru" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_white_circle_alpha" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="🔔 5 Perlu diproses" android:textColor="#FFFFFF" android:textSize="9sp" />

                            <com.github.mikephil.charting.charts.LineChart
                                android:id="@+id/lineChartPendapatan"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#35A1F8"
                        app:cardCornerRadius="12dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pendapatan (Hari)" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvAdminPendapatanHari" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Rp 0" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#35A1F8"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pendapatan (Bulan Ini)" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvAdminPendapatanBulan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Rp 0" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#35A1F8"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status Pemesanan" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/pieChartStatus"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#35A1F8"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Produk Terpopuler (Bulan Ini)" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/barChartProduk"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View android:layout_width="match_parent" android:layout_height="30dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_tab_pesanan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginTop="8dp" android:text="Manajemen Pesanan" android:textColor="#111111" android:textSize="18sp" android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_admin_search"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_margin="8dp"
                    android:background="@android:drawable/editbox_background"
                    android:hint="Cari Kode Booking / User..."
                    android:paddingHorizontal="16dp" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/container_filters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <HorizontalScrollView
                        android:id="@+id/hsv_admin_categories"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btn_filter_bulan"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_filter_semua"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginEnd="8dp"
                                android:text="Semua"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                app:backgroundTint="#2DA0F5"
                                app:cornerRadius="20dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_filter_wisata"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginEnd="8dp"
                                android:text="Wisata"
                                android:textAllCaps="false"
                                android:textColor="#333333"
                                android:textSize="12sp"
                                app:backgroundTint="#F0F0F0"
                                app:cornerRadius="20dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_filter_kereta"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginEnd="8dp"
                                android:text="Kereta Api"
                                android:textAllCaps="false"
                                android:textColor="#333333"
                                android:textSize="12sp"
                                app:backgroundTint="#F0F0F0"
                                app:cornerRadius="20dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_filter_pesawat"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginEnd="8dp"
                                android:text="Pesawat"
                                android:textAllCaps="false"
                                android:textColor="#333333"
                                android:textSize="12sp"
                                app:backgroundTint="#F0F0F0"
                                app:cornerRadius="20dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_filter_bus"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginEnd="16dp"
                                android:text="Bus"
                                android:textAllCaps="false"
                                android:textColor="#333333"
                                android:textSize="12sp"
                                app:backgroundTint="#F0F0F0"
                                app:cornerRadius="20dp" />

                        </LinearLayout>
                    </HorizontalScrollView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_filter_bulan"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_marginEnd="16dp"
                        android:padding="0dp"
                        app:backgroundTint="#FFFFFF"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_filter_list"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="24dp"
                        app:iconTint="#333333"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_admin_all_orders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp" />

                <View android:layout_width="match_parent" android:layout_height="80dp" />
            </LinearLayout>

        </FrameLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutNavbarAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_navbar"
        android:paddingBottom="20dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layoutIndicatorAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:background="#752674AE"
            android:paddingLeft="60dp"
            android:layout_marginBottom="13dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/navbarIndicatorAdmin"
                android:layout_width="80dp"
                android:layout_height="7dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_navbar2"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutNavbarIconAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="60dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnAdminStats"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_home_white"
                android:scaleType="fitXY"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageView
                android:id="@+id/btnAdminOrders"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_order_blue"
                android:scaleType="fitXY"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutNavbarTextAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="55dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAdminStats"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Statistik"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvAdminOrders"
                android:textColor="#0A4181"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Pemesanan"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>