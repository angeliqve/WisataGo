<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/riid7muyj6t"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="36dp"
            android:paddingVertical="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kotak"
                android:elevation="10dp"
                android:orientation="vertical"
                android:paddingVertical="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="29dp"
                    android:text="Sign Up"
                    android:textColor="#003F7C"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="34dp"
                    android:layout_marginBottom="10dp"
                    android:text="Username"
                    android:textColor="#165587"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNamaDaftar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="33dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/kotakformdata"
                    android:hint="Masukkan nama Anda"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:textColor="#000000"
                    android:textColorHint="#8A8A8A"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="34dp"
                    android:layout_marginBottom="10dp"
                    android:text="Email"
                    android:textColor="#165587"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etEmailDaftar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="33dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/kotakformdata"
                    android:hint="Masukkan email Anda"
                    android:inputType="textEmailAddress"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:textColor="#000000"
                    android:textColorHint="#8A8A8A"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="33dp"
                    android:layout_marginBottom="10dp"
                    android:text="Password"
                    android:textColor="#165587"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etPasswordDaftar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="33dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/kotakformdata"
                    android:hint="Buat password"
                    android:inputType="textPassword"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:textColor="#000000"
                    android:textColorHint="#8A8A8A"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="33dp"
                    android:layout_marginBottom="10dp"
                    android:text="Nomor Telepon"
                    android:textColor="#165587"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNoTeleponDaftar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="33dp"
                    android:layout_marginBottom="28dp"
                    android:background="@drawable/kotakformdata"
                    android:hint="08xxxxxxxxxx"
                    android:inputType="phone"
                    android:maxLength="13"
                    android:digits="0123456789"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:textColor="#000000"
                    android:textColorHint="#8A8A8A"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btnTombolDaftar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_login2"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="53dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:text="Daftar"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSudahPunyaAkun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="Sudah Punya Akun?\nLog In"
                    android:textColor="#165587"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>