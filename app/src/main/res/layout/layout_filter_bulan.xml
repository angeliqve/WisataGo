<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:background="#E0E0E0" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bulan"
        android:textColor="#111111"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>


    <TextView android:id="@+id/opt_jan" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="Januari" android:textColor="#333333" android:textSize="16sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

    <TextView android:id="@+id/opt_feb" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="Februari" android:textColor="#333333" android:textSize="16sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

    <TextView android:id="@+id/opt_mar" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="Maret" android:textColor="#333333" android:textSize="16sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

    <TextView android:id="@+id/opt_apr" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="April" android:textColor="#333333" android:textSize="16sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

    <TextView android:id="@+id/opt_mei" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="Mei" android:textColor="#333333" android:textSize="16sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" />

    <TextView android:id="@+id/opt_jun" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:text="Juni" android:textColor="#333333" android:textSize="16sp" />

</LinearLayout>