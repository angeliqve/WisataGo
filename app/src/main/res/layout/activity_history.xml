<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#2DA0F5"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pesanan Saya"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_user_filter_bulan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:icon="@android:drawable/ic_menu_month"
                app:iconTint="#333333"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="20dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#DDDDDD" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_user_filter_semua"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Semua"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:backgroundTint="#2DA0F5"
                app:cornerRadius="20dp"
                android:minHeight="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_user_filter_wisata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Wisata"
                android:textColor="#333333"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:backgroundTint="#F0F0F0"
                app:cornerRadius="20dp"
                android:minHeight="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_user_filter_kereta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Kereta"
                android:textColor="#333333"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:backgroundTint="#F0F0F0"
                app:cornerRadius="20dp"
                android:minHeight="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_user_filter_pesawat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Pesawat"
                android:textColor="#333333"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:backgroundTint="#F0F0F0"
                app:cornerRadius="20dp"
                android:minHeight="40dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_user_filter_bus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Bus"
                android:textColor="#333333"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:backgroundTint="#F0F0F0"
                app:cornerRadius="20dp"
                android:minHeight="40dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp" />

    <LinearLayout
        android:id="@+id/layoutNavbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_navbar"
        android:paddingBottom="20dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layoutIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="#752674AE"
            android:layout_marginBottom="13dp">

            <LinearLayout
                android:id="@+id/navbarIndicator"
                android:layout_width="80dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_navbar2"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutNavbarIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="40dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_home_blue"
                android:scaleType="fitXY"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageView
                android:id="@+id/btnPemesanan"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_order_white"
                android:scaleType="fitXY"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageView
                android:id="@+id/btnProfile"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_profile_blue"
                android:scaleType="fitXY"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutNavbarText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="41dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHome"
                android:textColor="#0A4181"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Home"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvPemesanan"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Pemesanan"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvProfile"
                android:textColor="#0A4181"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Profil"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>