<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/rc0fkyl4dwuf"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="36dp">

            <LinearLayout
                android:id="@+id/rk4a3h352g2g"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kotak"
                android:paddingVertical="35dp"
                android:elevation="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rggq1w3o19e"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="31dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/r90oc3wwn4yh"
                        android:textColor="#003F7C"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Log In" />
                </LinearLayout>

                <TextView
                    android:id="@+id/r1qnbiymm98s"
                    android:textColor="#165587"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="36dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Username/Email" />

                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="35dp"
                    android:layout_marginBottom="21dp"
                    android:background="@drawable/kotakformdata"
                    android:hint="Masukkan username atau email"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#000000"
                    android:textColorHint="#8A8A8A"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/r96igiylrkz"
                    android:textColor="#165587"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="35dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Password" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="35dp"
                    android:layout_marginBottom="30dp"
                    android:background="@drawable/kotakformdata"
                    android:hint="Masukkan password"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:gravity="center_vertical"
                    android:textColor="#000000"
                    android:textColorHint="#8A8A8A"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:maxLines="1" />

                <LinearLayout
                    android:id="@+id/reqr1zgfhv1u"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rl822png1s6q"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:background="@drawable/bg_login2"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="51dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/r2dioe9li4qm"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:clickable="false"
                            android:text="Masuk" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/rmbtfuctunlg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:minWidth="150dp"
                        android:gravity="center"
                        android:padding="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:text="Belum Punya Akun?\nSign Up"
                        android:textColor="#165587"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>