<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2DA0F5"
                android:paddingVertical="25dp"
                android:paddingLeft="30dp"
                android:layout_marginBottom="37dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitleProfile"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Profil Saya"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutUserProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="33dp"
                android:layout_marginStart="30dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginEnd="15dp"
                    android:src="@drawable/avatar_placeholder"
                    android:scaleType="fitXY"/>

                <LinearLayout
                    android:id="@+id/layoutProfileInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingRight="2dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUserName"
                        android:textColor="#0294F2"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="User Ke Satu"/>

                    <TextView
                        android:id="@+id/tvUserEmail"
                        android:textColor="#0061CC"
                        android:textSize="14sp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginStart="2dp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="userke1@gmail.com"/>

                    <LinearLayout
                        android:id="@+id/btnEditProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_login2"
                        android:paddingVertical="3dp"
                        android:paddingLeft="8dp"
                        android:paddingRight="31dp"
                        android:layout_marginStart="1dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEditProfile"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="Edit Profile"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutPengaturan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login2"
                android:paddingVertical="21dp"
                android:paddingRight="18dp"
                android:layout_marginBottom="28dp"
                android:layout_marginHorizontal="30dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPengaturan"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="25dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Pengaturan"/>

                <LinearLayout
                    android:id="@+id/linePengaturan"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="18dp"/>

                <LinearLayout
                    android:id="@+id/btnInformasiAkun"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="18dp"
                    android:layout_marginStart="25dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgInformasiAkun"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/icon_informasiakun"
                        android:scaleType="fitXY"/>

                    <TextView
                        android:id="@+id/tvInformasiAkun"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Informasi Akun"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>

                    <ImageView
                        android:id="@+id/imgArrowInformasi"
                        android:layout_width="12dp"
                        android:layout_height="24dp"
                        android:src="@drawable/icon_arrowright"
                        android:scaleType="fitXY"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutSuara"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="15dp"
                    android:layout_marginStart="26dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgSuara"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/icon_suaradanefek"
                        android:scaleType="fitXY"/>

                    <TextView
                        android:id="@+id/tvSuara"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Suara &amp; Efek"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>

                    <ImageView
                        android:id="@+id/btnSwitchSuara"
                        android:layout_width="44dp"
                        android:layout_height="22dp"
                        android:src="@drawable/button_switch"
                        android:scaleType="fitXY"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutNotifikasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginStart="23dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgNotifikasi"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="9dp"
                        android:src="@drawable/icon_notifikasi"
                        android:scaleType="fitXY"/>

                    <TextView
                        android:id="@+id/tvNotifikasi"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Notifikasi"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>

                    <ImageView
                        android:id="@+id/btnSwitchNotifikasi"
                        android:layout_width="44dp"
                        android:layout_height="22dp"
                        android:src="@drawable/button_switch"
                        android:scaleType="fitXY"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutLainnya"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login2"
                android:paddingVertical="22dp"
                android:paddingRight="18dp"
                android:layout_marginBottom="209dp"
                android:layout_marginHorizontal="30dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLainnya"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="11dp"
                    android:layout_marginStart="25dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Lainnya"/>

                <LinearLayout
                    android:id="@+id/lineLainnya"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="18dp"/>

                <LinearLayout
                    android:id="@+id/btnBantuan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="17dp"
                    android:layout_marginStart="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgBantuan"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/icon_bantuan"
                        android:scaleType="fitXY"/>

                    <TextView
                        android:id="@+id/tvBantuan"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Bantuan &amp; Panduan"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>

                    <ImageView
                        android:id="@+id/imgArrowBantuan"
                        android:layout_width="12dp"
                        android:layout_height="24dp"
                        android:src="@drawable/icon_arrowright"
                        android:scaleType="fitXY"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginStart="25dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgLogout"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="9dp"
                        android:src="@drawable/icon_logout"
                        android:scaleType="fitXY"/>

                    <TextView
                        android:id="@+id/tvLogout"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Logout"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/layoutNavbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_navbar"
        android:paddingBottom="20dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layoutIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:background="#752674AE"
            android:paddingRight="15dp"
            android:layout_marginBottom="13dp">

            <LinearLayout
                android:id="@+id/navbarIndicator"
                android:layout_width="80dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_navbar2"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutNavbarIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="40dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_home_blue"
                android:scaleType="fitXY"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageView
                android:id="@+id/btnPemesanan"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_order_blue"
                android:scaleType="fitXY"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageView
                android:id="@+id/btnProfile"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/icon_profile_white"
                android:scaleType="fitXY"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutNavbarText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="41dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHome"
                android:textColor="#0A4181"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Home"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvPemesanan"
                android:textColor="#0A4181"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Pemesanan"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvProfile"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Profil"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>